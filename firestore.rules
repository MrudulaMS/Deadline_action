rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety catch-all: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && data.timezone is string && data.timezone.size() > 0 && data.timezone.size() <= 50;
    }

    function isValidUserSettings(data) {
      return data.dailyWorkloadThreshold is number && data.dailyWorkloadThreshold > 0 && data.dailyWorkloadThreshold <= 24
        && data.weeklyWorkloadThreshold is number && data.weeklyWorkloadThreshold > 0 && data.weeklyWorkloadThreshold <= 168
        && data.weekStartsOn is string && (data.weekStartsOn == 'Monday' || data.weekStartsOn == 'Sunday');
    }

    function isValidTask(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.category is string && (data.category in ['assignment', 'exam', 'project', 'club', 'event', 'personal', 'other'])
        && data.deadlineDate is string && data.deadlineDate.size() == 10
        && data.estimatedMinutes is number && data.estimatedMinutes > 0 && data.estimatedMinutes <= 20000
        && data.priority is string && (data.priority in ['low', 'medium', 'high', 'critical'])
        && data.status is string && (data.status in ['pending', 'in_progress', 'completed', 'archived'])
        && data.isFlexible is bool;
    }

    function isValidSubtask(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.completed is bool
        && data.position is number;
    }

    // User profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if false;

      // User preferences
      match /settings/preferences {
        allow get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidUserSettings(incoming());
        allow delete: if false;
      }

      // Legal terms acceptance
      match /legal/terms {
        allow get: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if false;
      }

      // AI request audit log
      match /aiRequests/{requestId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      // Tasks collection
      match /tasks/{taskId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTask(incoming());
        allow update: if isOwner(userId) && isValidTask(incoming());
        allow delete: if false; // Soft deletes enforced via deletedAt

        // Subtasks subcollection
        match /subtasks/{subtaskId} {
          allow list: if isOwner(userId);
          allow get: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidSubtask(incoming());
          allow delete: if isOwner(userId);
        }
      }
    }
  }
}
